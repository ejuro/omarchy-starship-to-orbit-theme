# Starship To Orbit for btop: white text on glass, every graph drawn as a Raptor plume,
# white-hot at the base, engine-flame orange through the middle, red-orange at the peaks.
# Same colours as extras/cliamp/starship-to-orbit.toml.
theme[main_bg]=""
theme[main_fg]="#f5f5f7"
theme[title]="#ffffff"
theme[hi_fg]="#ff9f0a"
theme[selected_bg]="#3a3a3c"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#636366"
theme[graph_text]="#fff3dc"
theme[meter_bg]="#2c2c2e"
theme[proc_misc]="#c3ccd6"
theme[cpu_box]="#48484a"
theme[mem_box]="#48484a"
theme[net_box]="#48484a"
theme[proc_box]="#48484a"
theme[div_line]="#3a3a3c"
theme[temp_start]="#fff3dc"
theme[temp_mid]="#ff9f0a"
theme[temp_end]="#ff4f1f"
theme[cpu_start]="#fff3dc"
theme[cpu_mid]="#ff9f0a"
theme[cpu_end]="#ff4f1f"
